{
    "name": "componenta/app",
    "description": "Application runtime contracts, bootstrap, discovery, and container support for Componenta",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5.13",
        "componenta/class-finder": "^2.2.0",
        "componenta/config": "^4.0.0",
        "componenta/di": "^6.0.0",
        "componenta/path-resolver": "^1.0",
        "componenta/reflection": "^3.0.0",
        "componenta/scope": "^1.0",
        "componenta/tokenizer": "^1.0",
        "componenta/var-export": "^2.0",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "phpbench/phpbench": "^1.7"
    },
    "autoload": {
        "files": [
            "src/functions.php"
        ],
        "psr-4": {
            "Componenta\\App\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "6.0.x-dev",
            "dev-refactor/app-runtime-contracts": "6.0.x-dev",
            "dev-refactor/unified-application-build-2026-11-27": "6.0.x-dev"
        },
        "componenta": {
            "config-providers": [
                "Componenta\\App\\ConfigProvider"
            ]
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "bench": "@php vendor/bin/phpbench run --report=aggregate"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
